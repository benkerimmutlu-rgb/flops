# Скопируй в .env.local (для локального запуска) и добавь те же переменные в
# Vercel → Project → Settings → Environment Variables (для деплоя).
# Значения берутся в Supabase → Project Settings → API.
#
# Пока эти переменные не заданы, приложение работает в локальном режиме
# (прогресс в браузере, без входа) — это нормально для разработки.

NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ВАШ_ANON_KEY
